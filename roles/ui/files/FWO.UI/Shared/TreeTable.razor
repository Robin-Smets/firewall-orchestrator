        private List<RenderFragment> CreateTableHeads()
        {
            columnById = new(); // neu aufbauen

            List<RenderFragment> tableHeads = new()
            {
                Head(c =>
                {
                    c.Add("Title", userConfig.GetText("name"));
                    c.Add("OnSort", EventCallback.Factory.Create<string>(this, SortBy));
                    c.Add("SortContext", "Name");
                    c.Add("Sortable", true);
                    c.Add("SortAscending", SortAscending);
                }),
                Head(c =>
                {
                    c.Add("Title", userConfig.GetText("number"));
                    c.Add("OnSort", EventCallback.Factory.Create<string>(this, SortBy));
                    c.Add("SortContext", "OrderNumber");
                    c.Add("Sortable", true);
                    c.Add("SortAscending", SortAscending);
                }),
                AddHeadWithId("RulesReportSourceZoneColumn", c =>
                {
                    c.Add("Title", userConfig.GetText("source_zone"));
                    c.Add("Hideable", true);
                    c.Add("HideClass", "text-secondary text-info-hover");
                }),
                Head(c => c.Add("Title", userConfig.GetText("source"))),
                Head(c => c.Add("Title", userConfig.GetText("destination_zone"))),
                Head(c => c.Add("Title", userConfig.GetText("destination"))),
                Head(c => c.Add("Title", userConfig.GetText("services"))),
                Head(c => c.Add("Title", userConfig.GetText("action"))),
                Head(c => c.Add("Title", userConfig.GetText("track"))),
                Head(c => c.Add("Title", userConfig.GetText("enabled"))),
                AddHeadWithId("RulesReportUidColumn", c =>
                {
                    c.Add("Title", userConfig.GetText("uid"));
                    c.Add("Hideable", true);
                    c.Add("HideClass", "text-secondary text-info-hover");
                    c.Add("OnSort", EventCallback.Factory.Create<string>(this, SortBy));
                    c.Add("SortContext", "Uid");
                    c.Add("Sortable", true);
                    c.Add("SortAscending", SortAscending);
                }),
                AddHeadWithId("RulesReportCommentColumn", c =>
                {
                    c.Add("Title", userConfig.GetText("comment"));
                    c.Add("Hideable", true);
                    c.Add("HideClass", "text-secondary text-info-hover");
                    c.Add("OnSort", EventCallback.Factory.Create<string>(this, SortBy));
                    c.Add("SortContext", "Comment");
                    c.Add("Sortable", true);
                    c.Add("SortAscending", SortAscending);
                })
            };

            return tableHeads;
        }

        private RenderFragment AddHeadWithId(string columnId, Action<dynamic> configure)
        {
            var fragment = Head(c =>
            {
                configure(c);
                c.Add("ColumnId", columnId);
            });

            columnById[columnId] = fragment;
            return fragment;
        }



        public static void MoveColumnBehind(
            List<RenderFragment> columns,
            Dictionary<string, RenderFragment> columnById,
            string moveColumnId,
            string targetColumnId)
        {
            if (!columnById.TryGetValue(moveColumnId, out var toMove) ||
                !columnById.TryGetValue(targetColumnId, out var target))
            {
                return; // Spalten nicht gefunden → keine Änderung
            }

            // Aktuelle Positionen ermitteln
            int currentIndex = columns.IndexOf(toMove);
            int targetIndex = columns.IndexOf(target);

            if (currentIndex == -1 || targetIndex == -1 || currentIndex == targetIndex)
                return; // Ungültige Indizes oder kein echter Positionswechsel

            // Entferne das Element aus der aktuellen Position
            columns.RemoveAt(currentIndex);

            // Wenn wir ein Element weiter oben verschieben, verringert sich der Zielindex
            if (currentIndex < targetIndex)
                targetIndex--;

            // Einfügen hinter dem Ziel
            columns.Insert(targetIndex + 1, toMove);
        }









    [Parameter, EditorRequired]
    public required List<TreeNode<TItem>> Nodes { get; set; } = new();

    [Parameter, EditorRequired]
    public required RenderFragment<TItem> CellTemplate { get; set; }

    private string? SortColumn { get; set; }
    private bool SortAscending { get; set; } = true;

    private NatRuleDisplayHtml? RuleDisplay;

    private string SearchText { get; set; } = string.Empty;
    public string AppliedSearchText { get; set; } = string.Empty;

    private Timer? debounceTimer;

    private int _hiddenColumnsCount = 0;
    private List<string> _hiddenColumns = new();

    private string _draggedColumnId;

    /// <summary>
    /// Initializes the component and sets up the rule display helper.
    /// </summary>
    protected override void OnInitialized()
    {
        RuleDisplay = new NatRuleDisplayHtml(userConfig);
        _eventMediator.Subscribe<TreeTableColumnChangeVisibilityEvent>("RulesReportSourceZoneColumnVisibilityChangedEvent", e => OnTreeTableColumnChangeVisibility(e.EventArgs as TreeTableColumnChangeVisibilityEventArgs));
        _eventMediator.Subscribe<TreeTableColumnChangeVisibilityEvent>("RulesReportUidColumnVisibilityChangedEvent", e => OnTreeTableColumnChangeVisibility(e.EventArgs as TreeTableColumnChangeVisibilityEventArgs));
        _eventMediator.Subscribe<TreeTableColumnChangeVisibilityEvent>("RulesReportCommentColumnVisibilityChangedEvent", e => OnTreeTableColumnChangeVisibility(e.EventArgs as TreeTableColumnChangeVisibilityEventArgs));
        _eventMediator.Subscribe<TreeTableHeaderDraggedEvent>("RulesReportColumnDraggedEvent", e => OnColumnDragged(e.EventArgs as TreeTableHeaderDraggedEventArgs));
        _eventMediator.Subscribe<TreeTableHeaderDraggedEvent>("RulesReportColumnDroppedEvent", e => OnColumnDropped(e.EventArgs as TreeTableHeaderDraggedEventArgs));

        TableHeads = CreateTableHeads();
    }

    private void OnTreeTableColumnChangeVisibility(TreeTableColumnChangeVisibilityEventArgs eventArgs)
    {
        if(eventArgs.NewVisibility == false)
        {
            _hiddenColumns.Add(eventArgs.ColumnId);
            _hiddenColumnsCount = _hiddenColumns.Count;
            StateHasChanged();
        }
    }

    private void OnColumnDragged(TreeTableHeaderDraggedEventArgs eventArgs)
    {
        _draggedColumnId = eventArgs.DraggedColumnId;
    }

    private void OnColumnDropped(TreeTableHeaderDraggedEventArgs eventArgs)
    {
        MoveColumnBehind(TableHeads, columnById, _draggedColumnId, eventArgs.TargetColumnId);
        StateHasChanged();
    }

    private void ShowAllColumns()
    {
        foreach(string columnId in _hiddenColumns.ToList())
        {
            ShowColumn(columnId);
        }
    }

    private void ShowColumn(string columnId)
    {
        TreeTableColumnChangeVisibilityEventArgs eventArgs = new();
        eventArgs.ColumnId = columnId;
        eventArgs.NewVisibility = true;
        TreeTableColumnChangeVisibilityEvent newEvent = new TreeTableColumnChangeVisibilityEvent(eventArgs);
        newEvent.EventId = $"ShowColumnVisibilityChangedEvent";
        
        _eventMediator.Publish(newEvent.EventId, newEvent);
        _hiddenColumns.Remove(eventArgs.ColumnId);
        _hiddenColumnsCount = _hiddenColumns.Count;
        StateHasChanged();
    }

    /// <summary>
    /// Returns the filtered and sorted tree nodes for display.
    /// </summary>
    private IEnumerable<TreeNode<TItem>> FilteredNodes => FilterAndSortNodes(Nodes);

    /// <summary>
    /// Filters and sorts the provided tree nodes based on search text and sorting options.
    /// </summary>
    private IEnumerable<TreeNode<TItem>> FilterAndSortNodes(IEnumerable<TreeNode<TItem>> nodes)
    {
        IEnumerable<TreeNode<TItem>> sorted = SortNodes(nodes);

        string filterText = string.IsNullOrWhiteSpace(AppliedSearchText) ? SearchText : AppliedSearchText;

        if(string.IsNullOrWhiteSpace(filterText) || typeof(TItem) != typeof(Rule))
            return sorted;

        IEnumerable<TreeNode<TItem>?> filtered = sorted
            .Select((TreeNode<TItem> n) => FilterNode(n, filterText))
            .Where((TreeNode<TItem>? n) => n != null);

        return filtered.Cast<TreeNode<TItem>>();
    }

    /// <summary>
    /// Recursively filters a tree node and its children based on the filter text.
    /// </summary>
    private TreeNode<TItem>? FilterNode(TreeNode<TItem> node, string filterText)
    {
        if(typeof(TItem) == typeof(Rule))
        {
            Rule? rule = node.Item as Rule;
            bool match =
                (rule?.Name?.Contains(filterText, StringComparison.OrdinalIgnoreCase) ?? false) ||
                (rule?.Destination?.Contains(filterText, StringComparison.OrdinalIgnoreCase) ?? false);

            if(match)
            {
                return node;
            }

            var filteredChildren = node.Children
                .Select(child => FilterNode(child, filterText))
                .Where(child => child != null)
                .Cast<TreeNode<TItem>>()
                .ToList();

            if(filteredChildren.Count > 0)
            {
                return new TreeNode<TItem>
                {
                    Item = node.Item,
                    IsExpanded = node.IsExpanded,
                    Children = filteredChildren
                };
            }
            else
            {
                return null;
            }
        }
        return node;
    }

    private IEnumerable<TreeNode<TItem>> SortNodes(IEnumerable<TreeNode<TItem>> nodes)
    {
        if (typeof(TItem) == typeof(Rule))
        {
            if (SortColumn == nameof(Rule.OrderNumber))
            {
                // Beibehaltung der Struktur für OrderNumber
                var ruleNodes = nodes.Cast<TreeNode<Rule>>().ToList();
                return SortTreeNodesLexicographically(ruleNodes, SortAscending)
                    .Cast<TreeNode<TItem>>();
            }
            else
            {
                // Rekursiv alle TreeNodes extrahieren, deren Item eine Rule ist
                IEnumerable<TreeNode<TItem>> FlattenRuleNodes(IEnumerable<TreeNode<TItem>> source)
                {
                    foreach (var node in source)
                    {
                        // Falls Item eine Rule ist, übernehmen, aber ohne Children
                        if (node.Item is Rule)
                        {
                            yield return new TreeNode<TItem>
                            {
                                Item = node.Item,
                                Children = new() // explizit leer
                            };
                        }

                        // Rekursion auf alle Children (auch Header oder Inline Layer)
                        if (node.Children != null)
                        {
                            foreach (var child in FlattenRuleNodes(node.Children))
                                yield return child;
                        }
                    }
                }

                var flatNodes = FlattenRuleNodes(nodes);

                // Sortierfunktion je nach Spalte
                Func<TreeNode<TItem>, object> keySelector = SortColumn switch
                {
                    nameof(Rule.Name)    => n => ((Rule)(object)n.Item).Name,
                    nameof(Rule.Uid)     => n => ((Rule)(object)n.Item).Uid,
                    nameof(Rule.Comment) => n => ((Rule)(object)n.Item).Comment,
                    _                    => n => 0
                };

                return SortAscending
                    ? flatNodes.OrderBy(keySelector)
                    : flatNodes.OrderByDescending(keySelector);
            }
        }

        return nodes;
    }





    /// <summary>
    /// Handles sorting logic when a column header is clicked.
    /// </summary>
    private void SortBy(string column)
    {
        if(SortColumn == column)
        {
            SortAscending = !SortAscending; // Toggle sort direction
        }
        else
        {
            SortColumn = column;
            SortAscending = true;
        }
    }

    public static List<TreeNode<Rule>> SortTreeNodesLexicographically(List<TreeNode<Rule>> nodes, bool ascending)
    {
        LexicographicalListComparer positionComparer = new();

        List<TreeNode<Rule>> SortLevel(List<TreeNode<Rule>> currentLevel)
        {
            var sortedNodes = ascending
                ? currentLevel.OrderBy(n => n.OrderPosition, positionComparer).ToList()
                : currentLevel.OrderByDescending(n => n.OrderPosition, positionComparer).ToList();

            foreach (var node in sortedNodes)
            {
                node.Children = SortLevel(node.Children);
            }

            return sortedNodes;
        }

        return SortLevel(nodes);
    }

    /// <summary>
    /// Toggles the expanded state of a tree node.
    /// </summary>
    private void ToggleNode(TreeNode<TItem> node)
    {
        node.IsExpanded = !node.IsExpanded;
    }

    /// <summary>
    /// Expands all nodes in the tree.
    /// </summary>
    private void ExpandAll()
    {
        SetNodesExpandedState(Nodes, true);
        StateHasChanged();
    }

    /// <summary>
    /// Collapses all nodes in the tree.
    /// </summary>
    private void CollapseAll()
    {
        SetNodesExpandedState(Nodes, false);
        StateHasChanged();
    }

    /// <summary>
    /// Recursively sets the expanded state for all nodes in the tree.
    /// </summary>
    private void SetNodesExpandedState(IEnumerable<TreeNode<TItem>> nodes, bool isExpanded)
    {
        if(nodes == null) return;

        foreach(TreeNode<TItem> node in nodes)
        {
            node.IsExpanded = isExpanded;
            SetNodesExpandedState(node.Children, isExpanded);
        }
    }

    /// <summary>
    /// Handles the key press event in the search bar, applying search on Enter.
    /// </summary>
    private void HandleSearchKeyPress(KeyboardEventArgs e)
    {
        if(e.Key == "Enter")
        {
            debounceTimer?.Dispose(); //Cancelling debounce because we are applying search immediately
            ApplySearch();
        }
    }

    /// <summary>
    /// Applies the current search text as the filter.
    /// </summary>
    private void ApplySearch()
    {
        AppliedSearchText = SearchText;
        StateHasChanged();
    }

    /// <summary>
    /// Clears the search text and removes the filter.
    /// </summary>
    private void ClearSearch()
    {
        SearchText = string.Empty;
        AppliedSearchText = string.Empty;
        StateHasChanged();
    }

    /// <summary>
    /// Handles the input event in the search bar with debounce.
    /// </summary>
    private void OnSearchInput(ChangeEventArgs e)
    {
        SearchText = e.Value?.ToString() ?? string.Empty;

        debounceTimer?.Dispose();
        debounceTimer = new Timer(_ =>
        {
            InvokeAsync(() =>
            {
                AppliedSearchText = SearchText;
                StateHasChanged();
            });
        }, null, GlobalConst.SearchInputDebounceTime, Timeout.Infinite);
    }

    /// <summary>
    /// Disposes the debounce timer when the component is disposed.
    /// </summary>
    public void Dispose()
    {
        debounceTimer?.Dispose();
    }
}