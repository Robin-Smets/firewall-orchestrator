
@using Microsoft.AspNetCore.Components.Rendering
@using FWO.Data.Report
@using FWO.Services.EventMediator.Events
@using FWO.Services.EventMediator.Interfaces
@using FWO.Ui.Display

@typeparam TItem

@inject IEventMediator _eventMediator
@inject UserConfig userConfig

<div class="tree-table-viewport" id="treeTableViewport">
    <div class="d-flex mb-2">
        <button class="btn btn-sm btn-secondary me-1" @onclick="ExpandAll">
            <span class="oi oi-fullscreen-enter"></span>
        </button>
        <button class="btn btn-sm btn-secondary me-1" @onclick="CollapseAll">
            <span class="oi oi-fullscreen-exit"></span>
        </button>
        <span class="pt-1">|</span>
        <button class="btn btn-sm btn-outline-secondary mx-1" @onclick="ShowAllColumns">
            <i class="bi bi-eye-slash-fill me-1"></i>
            @_hiddenColumnsCount
        </button>
        @* <div class="d-flex border border-rounded border-1">
            <button class="btn btn-sm btn-outline-secondary">
                <i class="bi bi-eye-slash-fill me-1"></i>
                Name
            </button>
        </div> *@
        <div class="d-flex ms-auto">
            <input id="searchbar"
                   class="form-control form-control-sm"
                   placeholder="@userConfig.GetText("search")"
                   value="@SearchText"
                   @oninput="OnSearchInput"
                   @onkeyup="HandleSearchKeyPress" />
            @if(string.IsNullOrWhiteSpace(SearchText))
            {
                <button class="btn btn-sm btn-outline-secondary mx-1" @onclick="ApplySearch">
                    <span class="oi oi-magnifying-glass"></span>
                </button>
            }
            else
            {
                <button class="btn btn-sm btn-outline-secondary mx-1" @onclick="ClearSearch">
                    <span class="oi oi-x"></span>
                </button>
            }
        </div>
    </div>

    <div class="tree-table-container">
        <table class="tree-table">
            <thead>
                <tr>
                    @* <TableHead Title="@(userConfig.GetText("name"))" OnSort="SortBy" SortContext="Name" Sortable="true" SortAscending="SortAscending"/>

                    <TableHead Title="@(userConfig.GetText("number"))" OnSort="SortBy" SortContext="OrderNumber" Sortable="true" SortAscending="SortAscending"/>
                    <TableHead Title="@(userConfig.GetText("source_zone"))" Hideable="true" HideClass="text-secondary text-info-hover" ColumnId="RulesReportSourceZoneColumn"/>
                    <TableHead Title="@(userConfig.GetText("source"))"/>
                    <TableHead Title="@(userConfig.GetText("destination_zone"))" />
                    <TableHead Title="@(userConfig.GetText("destination"))" />
                    <TableHead Title="@(userConfig.GetText("services"))" />
                    <TableHead Title="@(userConfig.GetText("action"))" />
                    <TableHead Title="@(userConfig.GetText("track"))" />
                    <TableHead Title="@(userConfig.GetText("enabled"))" />

                    <TableHead Title="@(userConfig.GetText("uid"))" Hideable="true" HideClass="text-secondary text-info-hover" OnSort="SortBy" SortContext="Uid" Sortable="true" SortAscending="SortAscending" ColumnId="RulesReportUidColumn"/>

                    <TableHead Title="@(userConfig.GetText("comment"))" Hideable="true" HideClass="text-secondary text-info-hover" OnSort="SortBy" SortContext="Comment" Sortable="true" SortAscending="SortAscending" ColumnId="RulesReportCommentColumn"/> *@
                    @foreach (var head in TableHeads)
                    {
                        @head
                    }
                </tr>
            </thead>
            <tbody>
                @if(FilteredNodes is not null)
                {
                    @foreach(TreeNode<TItem> node in FilteredNodes)
                    {
                        <TreeTableRow TItem="TItem" Node="node" Level="0" CellTemplate="CellTemplate" OnToggle="ToggleNode" RuleDisplay="RuleDisplay" />
                    }
                }
            </tbody>
        </table>
    </div>
</div>

