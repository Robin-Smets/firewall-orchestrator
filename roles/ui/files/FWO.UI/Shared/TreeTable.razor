            }
            else if(SortColumn == nameof(Rule.Uid))
            {
                return SortAscending
                    ? nodes.OrderBy((TreeNode<TItem> n) => ((Rule)(object)n.Item).Uid)
                    : nodes.OrderByDescending((TreeNode<TItem> n) => ((Rule)(object)n.Item).Uid);
            }
            else if(SortColumn == nameof(Rule.Comment))
            {
                return SortAscending
                    ? nodes.OrderBy((TreeNode<TItem> n) => ((Rule)(object)n.Item).Comment)
                    : nodes.OrderByDescending((TreeNode<TItem> n) => ((Rule)(object)n.Item).Comment);
            }
        }
        return nodes;
    } *@

    @* /// <summary>
